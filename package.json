{
  "name": "github-network-graph",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Visualize the GitHub network graph (forks + main repo) in a dedicated tab.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "build:prod": "cross-env NODE_ENV=production tsc -b && cross-env NODE_ENV=production vite build --mode production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "package": "pnpm build:prod && node scripts/package.mjs",
    "clean": "rimraf dist releases",
    "release": "pnpm version patch && git push --follow-tags",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@aptabase/web": "^0.5.0",
    "@tanstack/react-virtual": "^3.14.26",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.1.43",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "archiver": "^8.0.0",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "rimraf": "^6.1.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "author": "pr-kzk <pr-kzk@gmail.com>",
  "homepage": "https://github.com/pr-kzk/github-network-graph#readme",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pr-kzk/github-network-graph.git"
  },
  "bugs": {
    "url": "https://github.com/pr-kzk/github-network-graph/issues"
  }
}
